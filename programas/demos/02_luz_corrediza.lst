DIR  BYTES        LÍN  FUENTE
---  -----------  ---  --------------------------------------------
                    1  ; ─────────────────────────────────────────────────────────────────────────
                    2  ; 02_luz_corrediza.asm — un LED encendido que recorre los 8 bits
                    3  ;
                    4  ; El set no tiene instrucción de desplazamiento, pero sumar un número
                    5  ; consigo mismo (A + A = 2·A) desplaza todos sus bits una posición a la
                    6  ; izquierda. Cuando el 1 sale por el bit 7, el resultado es 0 (Z = 1) y el
                    7  ; bit perdido queda en el acarreo (C = 1): eso termina cada vuelta.
                    8  ;
                    9  ; Demuestra: ADD como desplazamiento, Z/C al desbordar 8 bits, bucles
                   10  ; anidados (bits dentro de vueltas).
                   11  ;
                   12  ; PARA CAMBIAR LAS VUELTAS: LOAD 0xC0 <n>   (n >= 1)
                   13  ; En hardware: VEL 200 antes de RUN.
                   14  ;
                   15  ; Salida esperada: [1, 2, 4, 8, 16, 32, 64, 128] repetido 3 veces
                   16  ; ─────────────────────────────────────────────────────────────────────────
                   17
00   10 C0         18          MOV A,[VUELTAS]
02   50 C1         19          MOV [CONTADOR],A     ; contador = vueltas
                   20
04   30 01         21  VUELTA: MOV A,1              ; enciende el bit 0
06   B0            22  CORRE:  OUT
07   50 C2         23          MOV [TEMP],A
09   20 C2         24          MOV B,[TEMP]         ; B = A (copia a través de memoria)
0B   60            25          ADD                  ; A = A + A → desplaza 1 bit a la izquierda
0C   F0 06         26          JNZ CORRE            ; A = 0 cuando el 1 se cae por el bit 7
                   27
0E   10 C1         28          MOV A,[CONTADOR]
10   40 01         29          MOV B,1
12   70            30          SUB
13   50 C1         31          MOV [CONTADOR],A     ; contador -= 1
15   F0 04         32          JNZ VUELTA
17   C0            33          HLT
                   34
                   35  ; ── Zona de datos ────────────────────────────────────────────────────────
                   36  .ORG 0xC0
C0   03            37  VUELTAS:  .DB 3              ; <<<< cuántas vueltas dar (0xC0)
C1   00            38  CONTADOR: .DB 0              ; 0xC1
C2   00            39  TEMP:     .DB 0              ; 0xC2 — puente para copiar A en B

TABLA DE SÍMBOLOS
VUELTA   = 0x04 (4)
CORRE    = 0x06 (6)
VUELTAS  = 0xC0 (192)
CONTADOR = 0xC1 (193)
TEMP     = 0xC2 (194)
