DIR  BYTES        LÍN  FUENTE
---  -----------  ---  --------------------------------------------
                    1  ; ─────────────────────────────────────────────────────────────────────────
                    2  ; 03_parpadeo.asm — patrón que se invierte (LEDs alternados)
                    3  ;
                    4  ; Muestra un patrón y luego su complemento, una y otra vez. El set no tiene
                    5  ; NOT: se obtiene con XOR contra 0xFF (cada bit se invierte). Con el patrón
                    6  ; 0x55 = 01010101 los LEDs alternan con 0xAA = 10101010.
                    7  ;
                    8  ; Demuestra: XOR como NOT, que MOV no altera las banderas (el JNZ usa la Z
                    9  ; del SUB aunque entre medio haya un MOV A,[TEMP]).
                   10  ;
                   11  ; PARA CAMBIAR EL PATRÓN: LOAD 0xC0 <patron>   (p. ej. 0x0F, 0x81, 0x33)
                   12  ; PARA CAMBIAR CUÁNTOS:   LOAD 0xC1 <n>
                   13  ; En hardware: VEL 400 antes de RUN.
                   14  ;
                   15  ; Salida esperada: [85, 170, 85, 170, 85, 170, 85, 170]
                   16  ; ─────────────────────────────────────────────────────────────────────────
                   17
00   10 C1         18         MOV A,[VECES]
02   50 C2         19         MOV [CONTADOR],A
04   10 C0         20         MOV A,[PATRON]
                   21
06   B0            22  OTRA:  OUT                  ; muestra el patrón actual
07   40 FF         23         MOV B,0xFF
09   A0            24         XOR                  ; A = NOT A
0A   50 C3         25         MOV [TEMP],A         ; guarda el patrón invertido
                   26
0C   10 C2         27         MOV A,[CONTADOR]
0E   40 01         28         MOV B,1
10   70            29         SUB
11   50 C2         30         MOV [CONTADOR],A     ; contador -= 1  (aquí se fija Z)
13   10 C3         31         MOV A,[TEMP]         ; recupera el patrón — MOV no toca Z
15   F0 06         32         JNZ OTRA
17   C0            33         HLT
                   34
                   35  ; ── Zona de datos ────────────────────────────────────────────────────────
                   36  .ORG 0xC0
C0   55            37  PATRON:   .DB 0x55           ; <<<< patrón inicial (0xC0)
C1   08            38  VECES:    .DB 8              ; <<<< cuántos patrones mostrar (0xC1)
C2   00            39  CONTADOR: .DB 0              ; 0xC2
C3   00            40  TEMP:     .DB 0              ; 0xC3

TABLA DE SÍMBOLOS
OTRA     = 0x06 (6)
PATRON   = 0xC0 (192)
VECES    = 0xC1 (193)
CONTADOR = 0xC2 (194)
TEMP     = 0xC3 (195)
