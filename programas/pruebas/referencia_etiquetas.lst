DIR  BYTES        LÍN  FUENTE
---  -----------  ---  --------------------------------------------
                    1  ; ─────────────────────────────────────────────────────────────────────────
                    2  ; referencia_etiquetas.asm — misma multiplicación 4 × 3 de A.7, escrita con
                    3  ; etiquetas de datos en vez de direcciones numéricas.
                    4  ;
                    5  ; Ensambla a bytes IDÉNTICOS a referencia.asm (hay un test que lo verifica):
                    6  ; las etiquetas son azúcar sintáctico puro, resuelto en la primera pasada.
                    7  ; Esta versión es la legible; referencia.asm es la fiel al documento.
                    8  ;
                    9  ; Resultado esperado: OUT muestra 12 (0x0C), luego HLT.
                   10  ; ─────────────────────────────────────────────────────────────────────────
                   11
00   30 00         12        MOV A,0
02   50 C8         13        MOV [RESULTADO],A  ; resultado = 0
04   30 03         14        MOV A,3
06   50 C9         15        MOV [CONTADOR],A   ; contador = 3
                   16
08   10 C8         17  LOOP: MOV A,[RESULTADO]
0A   20 CC         18        MOV B,[CUATRO]
0C   60            19        ADD
0D   50 C8         20        MOV [RESULTADO],A  ; resultado += 4
                   21
0F   10 C9         22        MOV A,[CONTADOR]
11   40 01         23        MOV B,1
13   70            24        SUB
14   50 C9         25        MOV [CONTADOR],A   ; contador -= 1
16   F0 08         26        JNZ LOOP
                   27
18   10 C8         28        MOV A,[RESULTADO]
1A   B0            29        OUT                ; muestra 12
1B   C0            30        HLT
                   31
                   32  ; ── Zona de datos (0xC0-0xFF según A.6) ──────────────────────────────────
                   33  .ORG 200
C8   00            34  RESULTADO: .DB 0         ; 200 (0xC8) — acumulador del producto
C9   00            35  CONTADOR:  .DB 0         ; 201 (0xC9) — cuántas sumas quedan
                   36
                   37  .ORG 204
CC   04            38  CUATRO:    .DB 4         ; 204 (0xCC) — el multiplicando

TABLA DE SÍMBOLOS
LOOP      = 0x08 (8)
RESULTADO = 0xC8 (200)
CONTADOR  = 0xC9 (201)
CUATRO    = 0xCC (204)
